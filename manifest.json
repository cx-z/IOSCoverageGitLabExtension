{
  "manifest_version": 3,
  "name": "iOS Coverage for GitLab",
  "version": "0.3.0",
  "description": "Shows read-only iOS changed-line coverage on verified GitLab merge request diffs.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "打开 iOS Coverage 设置"
  },
  "options_page": "src/options/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
